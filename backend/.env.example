STEAM_API_KEY=

# Steam HTTP pooling and per-process upstream concurrency
STEAM_MAX_CONCURRENCY=8
STEAM_MAX_RETRIES=2
STEAM_MAX_CONNECTIONS=16
STEAM_MAX_KEEPALIVE_CONNECTIONS=8
STEAM_TIMEOUT_CONNECT=5
STEAM_TIMEOUT_READ=20
STEAM_TIMEOUT_WRITE=10
STEAM_TIMEOUT_POOL=5

# In-memory cache TTLs in seconds
CACHE_PROFILE_TTL=300
CACHE_GAMES_TTL=600
CACHE_ACHIEVEMENTS_TTL=2700
CACHE_GLOBAL_ACHIEVEMENTS_TTL=3600
CACHE_NEGATIVE_TTL=30
CACHE_NEGATIVE_ACHIEVEMENTS_TTL=300
CACHE_MAX_ENTRIES=4096
CACHE_MAX_BYTES=67108864

# Per-IP fixed-window limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_PROFILE_PER_MINUTE=30
RATE_LIMIT_GAMES_PER_MINUTE=30
RATE_LIMIT_ACHIEVEMENTS_PER_MINUTE=1200